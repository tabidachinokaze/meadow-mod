{
	"schemaVersion": 1,
	"id": "meadow",
	"version": "${version}",
	"name": "Meadow",
	"description": "mods connected to the Meadow backend",
	"authors": [
		"tabidachinokaze"
	],
	"contact": {
		"homepage": "https://meadow.tabidachi.moe/",
		"sources": "https://github.com/tabidachinokaze/meadow-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/meadow/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			{
				"value": "moe.tabidachi.Meadow",
				"adapter": "kotlin"
			}
		],
		"client": [
			{
				"value": "moe.tabidachi.client.MeadowClient",
				"adapter": "kotlin"
			}
		],
		"fabric-datagen": [
			{
				"value": "moe.tabidachi.client.MeadowDataGenerator",
				"adapter": "kotlin"
			}
		]
	},
	"mixins": [
		"meadow.mixins.json",
		{
			"config": "meadow.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.18.5",
		"minecraft": "~26.1",
		"java": ">=25",
		"fabric-api": "*",
		"fabric-language-kotlin": "*"
	}
}